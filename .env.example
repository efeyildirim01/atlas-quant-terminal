# Copy to .env. Never commit .env. All values below are placeholders.
ATLAS_ENV=development
# Default (unset) = SQLite at apps/api/var/atlas_dev.db. Docker Compose overrides this with PostgreSQL.
# ATLAS_DATABASE_URL=postgresql+psycopg://atlas:<password>@localhost:5432/atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=atlas

# Development fixtures (synthetic, always labelled). Set to false in any environment showing real data.
ATLAS_ENABLE_FIXTURES=true
ATLAS_FIXTURE_END=2026-10-15

# Real sources (leave empty until access is granted)
ATLAS_EVDS_API_KEY=
ATLAS_EVDS_BASE_URL=https://evds2.tcmb.gov.tr/service/evds/
ATLAS_CSV_DIR=

ATLAS_CORS_ORIGINS=http://localhost:3000
ATLAS_SESSION_TTL_HOURS=12
ATLAS_RATE_LIMIT_PER_MIN=300
ATLAS_AUTH_RATE_LIMIT_PER_MIN=10
ATLAS_STALE_AFTER_BDAYS=3
ATLAS_LOG_JSON=true

# Production hardening (docs/operations/RUNBOOK.md). ATLAS_ENV=production refuses unsafe settings.
ATLAS_ENV=development
ATLAS_REDIS_URL=
ATLAS_TRUSTED_PROXIES=127.0.0.1/32,::1/128
ATLAS_MAX_BODY_BYTES=1000000
ATLAS_LOGIN_MAX_FAILURES=5
ATLAS_LOGIN_LOCKOUT_MINUTES=15
ATLAS_METRICS_TOKEN=
ATLAS_EXPOSE_DOCS=
ATLAS_BACKUP_DIR=
ATLAS_BACKUP_KEEP=14

# AI research copilot (docs/financial-methodology/AI_COPILOT.md)
ANTHROPIC_API_KEY=
ATLAS_AI_ENABLED=true
ATLAS_AI_MODEL=claude-opus-5-5
ATLAS_AI_EFFORT=medium
ATLAS_AI_MAX_ROUNDS=8
ATLAS_AI_QUERIES_PER_MIN=6

# Web
ATLAS_API_URL=http://127.0.0.1:8000
